{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/BillingAccount",
  "title": "BillingAccount",
  "type": "object",
  "properties": {
    "accountId": {
      "type": "string"
    },
    "policyId": {
      "type": "string"
    },
    "policyNumber": {
      "type": "string"
    },
    "balance": {
      "type": "number"
    },
    "nextDueDate": {
      "type": "string",
      "format": "date"
    },
    "nextDueAmount": {
      "type": "number"
    },
    "paymentPlan": {
      "type": "string",
      "enum": [
        "FULL_PAY",
        "SEMI_ANNUAL",
        "QUARTERLY",
        "MONTHLY",
        "DIRECT_BILL"
      ]
    }
  }
}